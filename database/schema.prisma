// ============================================================================
// SCHOOL MDM PORTAL - PRISMA SCHEMA (PHASE 2)
// Database: PostgreSQL
// Rules:
// - UUID Primary Keys across all 23 domain tables
// - Explicit foreign keys, indexes, unique constraints
// - Soft delete (deletedAt) on core entities
// - Never use `prisma db push` in production; use versioned SQL migrations
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum RoleCode {
  ADMIN
  TEACHER
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
  PENDING
  ERROR
}

enum MdmProviderType {
  HEADWIND_COMMUNITY
  CLASSROOM_DPC
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_FAILURE
  FAILED
}

enum PolicyVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ClassSessionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
}

enum SessionDeviceState {
  JOINED
  ONLINE
  OFFLINE
  POLICY_APPLIED
  RECONCILING
  RELEASED
  ERROR
}

enum CommandType {
  SYNC_DEVICE
  INSTALL_APP
  UPDATE_APP
  REMOVE_APP
  APPLY_CONFIGURATION
  LOCK_DEVICE
  REBOOT_DEVICE
  APPLY_KIOSK_POLICY
  APPLY_ALLOWLIST
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  SUCCESS
  FAILED
  TIMEOUT
  UNSUPPORTED
}

enum NotificationSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ----------------------------------------------------------------------------
// 1. IDENTITY (users, roles, user_roles, refresh_tokens)
// ----------------------------------------------------------------------------

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.VarChar(255)
  passwordHash        String    @map("password_hash") @db.VarChar(512)
  fullName            String    @map("full_name") @db.VarChar(255)
  phone               String?   @db.VarChar(50)
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz(6)
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz(6)
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime? @map("deleted_at") @db.Timestamptz(6)

  userRoles           UserRole[]
  refreshTokens       RefreshToken[]
  teacherClasses      TeacherClass[]
  startedSessions     ClassSession[]      @relation("SessionTeacher")
  dispatchedCommands  DeviceCommand[]     @relation("CommandActor")
  auditLogs           AuditLog[]          @relation("AuditActor")
  notifications       Notification[]
  createdPolicies     Policy[]            @relation("PolicyCreator")
  publishedVersions   PolicyVersion[]     @relation("PolicyPublisher")
  assignedDevices     DeviceAssignment[]  @relation("AssignmentActor")

  @@index([email])
  @@index([isActive, deletedAt])
  @@map("users")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        RoleCode   @unique
  name        String     @db.VarChar(100)
  description String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles   UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(255)
  familyId          String    @map("family_id") @db.Uuid
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ----------------------------------------------------------------------------
// 2. SCHOOL (academic_years, classes, teacher_classes, students)
// ----------------------------------------------------------------------------

model AcademicYear {
  id        String    @id @default(uuid()) @db.Uuid
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(150)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  classes   SchoolClass[]

  @@index([isCurrent, deletedAt])
  @@map("academic_years")
}

model SchoolClass {
  id             String       @id @default(uuid()) @db.Uuid
  academicYearId String       @map("academic_year_id") @db.Uuid
  code           String       @db.VarChar(50)
  name           String       @db.VarChar(150)
  gradeLevel     Int          @map("grade_level")
  roomName       String?      @map("room_name") @db.VarChar(100)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz(6)

  academicYear      AcademicYear       @relation(fields: [academicYearId], references: [id], onDelete: Restrict)
  teacherClasses    TeacherClass[]
  students          Student[]
  deviceAssignments DeviceAssignment[]
  classSessions     ClassSession[]

  @@unique([academicYearId, code])
  @@index([gradeLevel, isActive])
  @@map("classes")
}

model TeacherClass {
  id         String      @id @default(uuid()) @db.Uuid
  teacherId  String      @map("teacher_id") @db.Uuid
  classId    String      @map("class_id") @db.Uuid
  roleInClass String     @default("HOMEROOM") @map("role_in_class") @db.VarChar(50)
  isActive   Boolean     @default(true) @map("is_active")
  assignedAt DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  revokedAt  DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher    User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
  @@index([classId, isActive])
  @@map("teacher_classes")
}

model Student {
  id          String       @id @default(uuid()) @db.Uuid
  classId     String?      @map("class_id") @db.Uuid
  studentCode String       @unique @map("student_code") @db.VarChar(64)
  fullName    String       @map("full_name") @db.VarChar(255)
  dateOfBirth DateTime?    @map("date_of_birth") @db.Date
  isActive    Boolean      @default(true) @map("is_active")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz(6)

  schoolClass       SchoolClass?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  deviceAssignments DeviceAssignment[]

  @@index([classId, isActive])
  @@map("students")
}

// ----------------------------------------------------------------------------
// 3. DEVICES (devices, device_assignments, device_heartbeats, device_applications)
// ----------------------------------------------------------------------------

model Device {
  id                  String       @id @default(uuid()) @db.Uuid
  assetTag            String       @unique @map("asset_tag") @db.VarChar(100)
  serialNumber        String?      @unique @map("serial_number") @db.VarChar(128)
  imei                String?      @unique @db.VarChar(64)
  displayName         String       @map("display_name") @db.VarChar(255)
  manufacturer        String       @db.VarChar(120)
  model               String       @db.VarChar(120)
  androidVersion      String       @map("android_version") @db.VarChar(50)
  sdkVersion          Int          @map("sdk_version")
  hasGooglePlay       Boolean      @default(true) @map("has_google_play")
  status              DeviceStatus @default(UNKNOWN)
  batteryLevel        Int?         @map("battery_level")
  isCharging          Boolean?     @map("is_charging")
  ipAddress           String?      @map("ip_address") @db.VarChar(64)
  macAddress          String?      @map("mac_address") @db.VarChar(64)
  lastSeenAt          DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  enrolledAt          DateTime?    @map("enrolled_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?    @map("deleted_at") @db.Timestamptz(6)

  assignments         DeviceAssignment[]
  heartbeats          DeviceHeartbeat[]
  installedApps       DeviceApplication[]
  mdmLinks            MdmDeviceLink[]
  sessionDevices      SessionDevice[]
  commands            DeviceCommand[]

  @@index([status, lastSeenAt])
  @@index([deletedAt])
  @@map("devices")
}

model DeviceAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  deviceId       String       @map("device_id") @db.Uuid
  classId        String       @map("class_id") @db.Uuid
  studentId      String?      @map("student_id") @db.Uuid
  assignedById   String?      @map("assigned_by_id") @db.Uuid
  isActive       Boolean      @default(true) @map("is_active")
  assignedAt     DateTime     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  unassignedAt   DateTime?    @map("unassigned_at") @db.Timestamptz(6)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  device         Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  schoolClass    SchoolClass  @relation(fields: [classId], references: [id], onDelete: Restrict)
  student        Student?     @relation(fields: [studentId], references: [id], onDelete: SetNull)
  assignedBy     User?        @relation("AssignmentActor", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([deviceId, isActive])
  @@index([classId, isActive])
  @@map("device_assignments")
}

model DeviceHeartbeat {
  id                String   @id @default(uuid()) @db.Uuid
  deviceId          String   @map("device_id") @db.Uuid
  batteryLevel      Int?     @map("battery_level")
  isCharging        Boolean? @map("is_charging")
  wifiSsid          String?  @map("wifi_ssid") @db.VarChar(128)
  ipAddress         String?  @map("ip_address") @db.VarChar(64)
  foregroundPackage String?  @map("foreground_package") @db.VarChar(255)
  storageFreeMb     Int?     @map("storage_free_mb")
  ramFreeMb         Int?     @map("ram_free_mb")
  reportedAt        DateTime @default(now()) @map("reported_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, reportedAt(sort: Desc)])
  @@map("device_heartbeats")
}

model DeviceApplication {
  id            String       @id @default(uuid()) @db.Uuid
  deviceId      String       @map("device_id") @db.Uuid
  applicationId String?      @map("application_id") @db.Uuid
  packageName   String       @map("package_name") @db.VarChar(255)
  appName       String       @map("app_name") @db.VarChar(255)
  versionName   String       @map("version_name") @db.VarChar(100)
  versionCode   Int          @map("version_code")
  isSystemApp   Boolean      @default(false) @map("is_system_app")
  isSuspended   Boolean      @default(false) @map("is_suspended")
  installedAt   DateTime?    @map("installed_at") @db.Timestamptz(6)
  lastSyncedAt  DateTime     @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  device        Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@unique([deviceId, packageName])
  @@index([packageName])
  @@map("device_applications")
}

// ----------------------------------------------------------------------------
// 4. MDM (mdm_providers, mdm_device_links, mdm_sync_runs)
// ----------------------------------------------------------------------------

model MdmProvider {
  id               String          @id @default(uuid()) @db.Uuid
  code             String          @unique @db.VarChar(64)
  name             String          @db.VarChar(150)
  providerType     MdmProviderType @map("provider_type")
  baseUrl          String?         @map("base_url") @db.VarChar(512)
  providerVersion  String?         @map("provider_version") @db.VarChar(100)
  capabilitiesJson Json            @default("{}") @map("capabilities_json")
  isActive         Boolean         @default(true) @map("is_active")
  isDefault        Boolean         @default(false) @map("is_default")
  lastVerifiedAt   DateTime?       @map("last_verified_at") @db.Timestamptz(6)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  deviceLinks      MdmDeviceLink[]
  syncRuns         MdmSyncRun[]
  commands         DeviceCommand[]

  @@index([isActive, isDefault])
  @@map("mdm_providers")
}

model MdmDeviceLink {
  id               String      @id @default(uuid()) @db.Uuid
  providerId       String      @map("provider_id") @db.Uuid
  deviceId         String      @map("device_id") @db.Uuid
  externalDeviceId String      @map("external_device_id") @db.VarChar(255)
  externalNumber   String?     @map("external_number") @db.VarChar(255)
  syncStatus       String      @default("LINKED") @map("sync_status") @db.VarChar(50)
  lastSyncedAt     DateTime?   @map("last_synced_at") @db.Timestamptz(6)
  rawSnapshotJson  Json?       @map("raw_snapshot_json")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  provider         MdmProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  device           Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, externalDeviceId])
  @@unique([providerId, deviceId])
  @@index([deviceId])
  @@map("mdm_device_links")
}

model MdmSyncRun {
  id             String        @id @default(uuid()) @db.Uuid
  providerId     String        @map("provider_id") @db.Uuid
  triggerType    String        @map("trigger_type") @db.VarChar(50)
  status         SyncRunStatus @default(RUNNING)
  devicesFound   Int           @default(0) @map("devices_found")
  devicesCreated Int           @default(0) @map("devices_created")
  devicesUpdated Int           @default(0) @map("devices_updated")
  errorCount     Int           @default(0) @map("error_count")
  errorSummary   String?       @map("error_summary") @db.Text
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?     @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  provider       MdmProvider   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startedAt(sort: Desc)])
  @@map("mdm_sync_runs")
}

// ----------------------------------------------------------------------------
// 5. APPS & POLICIES (applications, policies, policy_versions, policy_apps)
// ----------------------------------------------------------------------------

model Application {
  id             String    @id @default(uuid()) @db.Uuid
  packageName    String    @unique @map("package_name") @db.VarChar(255)
  name           String    @db.VarChar(255)
  category       String    @default("EDUCATION") @db.VarChar(100)
  versionName    String    @map("version_name") @db.VarChar(100)
  versionCode    Int       @map("version_code")
  apkUrl         String?   @map("apk_url") @db.VarChar(1024)
  sha256Checksum String?   @map("sha256_checksum") @db.VarChar(128)
  isApproved     Boolean   @default(false) @map("is_approved")
  isMandatory    Boolean   @default(false) @map("is_mandatory")
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  deviceApps     DeviceApplication[]
  policyApps     PolicyApp[]

  @@index([isApproved, deletedAt])
  @@map("applications")
}

model Policy {
  id               String          @id @default(uuid()) @db.Uuid
  code             String          @unique @db.VarChar(100)
  name             String          @db.VarChar(255)
  description      String?         @db.Text
  createdById      String?         @map("created_by_id") @db.Uuid
  currentVersionId String?         @map("current_version_id") @db.Uuid
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz(6)

  createdBy        User?           @relation("PolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  versions         PolicyVersion[]
  classSessions    ClassSession[]

  @@index([isActive, deletedAt])
  @@map("policies")
}

model PolicyVersion {
  id                       String              @id @default(uuid()) @db.Uuid
  policyId                 String              @map("policy_id") @db.Uuid
  versionNumber            Int                 @map("version_number")
  status                   PolicyVersionStatus @default(DRAFT)
  kioskModeEnabled         Boolean             @default(false) @map("kiosk_mode_enabled")
  kioskPackageName         String?             @map("kiosk_package_name") @db.VarChar(255)
  appAllowlistEnabled      Boolean             @default(false) @map("app_allowlist_enabled")
  browserRestrictionsJson  Json                @default("{}") @map("browser_restrictions_json")
  networkRestrictionsJson  Json                @default("{}") @map("network_restrictions_json")
  deviceRestrictionsJson   Json                @default("{}") @map("device_restrictions_json")
  requiredCapabilitiesJson Json                @default("[]") @map("required_capabilities_json")
  publishedById            String?             @map("published_by_id") @db.Uuid
  publishedAt              DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  policy                   Policy              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  publishedBy              User?               @relation("PolicyPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  policyApps               PolicyApp[]
  classSessions            ClassSession[]

  @@unique([policyId, versionNumber])
  @@index([policyId, status])
  @@map("policy_versions")
}

model PolicyApp {
  id              String        @id @default(uuid()) @db.Uuid
  policyVersionId String        @map("policy_version_id") @db.Uuid
  applicationId   String        @map("application_id") @db.Uuid
  actionType      String        @default("ALLOW") @map("action_type") @db.VarChar(50)
  autoInstall     Boolean       @default(false) @map("auto_install")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id], onDelete: Cascade)
  application     Application   @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([policyVersionId, applicationId])
  @@map("policy_apps")
}

// ----------------------------------------------------------------------------
// 6. SESSIONS (class_sessions, session_devices)
// ----------------------------------------------------------------------------

model ClassSession {
  id              String             @id @default(uuid()) @db.Uuid
  classId         String             @map("class_id") @db.Uuid
  teacherId       String             @map("teacher_id") @db.Uuid
  policyId        String?            @map("policy_id") @db.Uuid
  policyVersionId String?            @map("policy_version_id") @db.Uuid
  title           String             @db.VarChar(255)
  subjectName     String?            @map("subject_name") @db.VarChar(150)
  status          ClassSessionStatus @default(SCHEDULED)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(6)
  endedAt         DateTime?          @map("ended_at") @db.Timestamptz(6)
  notes           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  schoolClass     SchoolClass        @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher         User               @relation("SessionTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  policy          Policy?            @relation(fields: [policyId], references: [id], onDelete: SetNull)
  policyVersion   PolicyVersion?     @relation(fields: [policyVersionId], references: [id], onDelete: SetNull)
  sessionDevices  SessionDevice[]
  commands        DeviceCommand[]

  @@index([classId, status])
  @@index([teacherId, status])
  @@map("class_sessions")
}

model SessionDevice {
  id                String             @id @default(uuid()) @db.Uuid
  sessionId         String             @map("session_id") @db.Uuid
  deviceId          String             @map("device_id") @db.Uuid
  state             SessionDeviceState @default(JOINED)
  joinedAt          DateTime           @default(now()) @map("joined_at") @db.Timestamptz(6)
  policyAppliedAt   DateTime?          @map("policy_applied_at") @db.Timestamptz(6)
  policyReleasedAt  DateTime?          @map("policy_released_at") @db.Timestamptz(6)
  lastOfflineAt     DateTime?          @map("last_offline_at") @db.Timestamptz(6)
  lastReconnectedAt DateTime?          @map("last_reconnected_at") @db.Timestamptz(6)
  lastErrorReason   String?            @map("last_error_reason") @db.Text
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  session           ClassSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device            Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([sessionId, deviceId])
  @@index([deviceId, state])
  @@map("session_devices")
}

// ----------------------------------------------------------------------------
// 7. COMMANDS & AUDIT (device_commands, command_attempts, audit_logs, notifications)
// ----------------------------------------------------------------------------

model DeviceCommand {
  id                String           @id @default(uuid()) @db.Uuid
  idempotencyKey    String           @unique @map("idempotency_key") @db.VarChar(128)
  deviceId          String           @map("device_id") @db.Uuid
  providerId        String           @map("provider_id") @db.Uuid
  sessionId         String?          @map("session_id") @db.Uuid
  actorUserId       String?          @map("actor_user_id") @db.Uuid
  commandType       CommandType      @map("command_type")
  payloadJson       Json             @default("{}") @map("payload_json")
  status            CommandStatus    @default(PENDING)
  externalCommandId String?          @map("external_command_id") @db.VarChar(255)
  maxRetries        Int              @default(3) @map("max_retries")
  retryCount        Int              @default(0) @map("retry_count")
  failureReason     String?          @map("failure_reason") @db.Text
  expiresAt         DateTime         @map("expires_at") @db.Timestamptz(6)
  sentAt            DateTime?        @map("sent_at") @db.Timestamptz(6)
  acknowledgedAt    DateTime?        @map("acknowledged_at") @db.Timestamptz(6)
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  device            Device           @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  provider          MdmProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  session           ClassSession?    @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  actorUser         User?            @relation("CommandActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  attempts          CommandAttempt[]

  @@index([deviceId, status])
  @@index([status, expiresAt])
  @@index([sessionId])
  @@map("device_commands")
}

model CommandAttempt {
  id                String        @id @default(uuid()) @db.Uuid
  commandId         String        @map("command_id") @db.Uuid
  attemptNumber     Int           @map("attempt_number")
  status            CommandStatus
  externalCommandId String?       @map("external_command_id") @db.VarChar(255)
  requestPayload    Json?         @map("request_payload")
  responsePayload   Json?         @map("response_payload")
  errorMessage      String?       @map("error_message") @db.Text
  startedAt         DateTime      @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?     @map("finished_at") @db.Timestamptz(6)

  command           DeviceCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)

  @@unique([commandId, attemptNumber])
  @@index([commandId])
  @@map("command_attempts")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorRole   String?  @map("actor_role") @db.VarChar(50)
  action      String   @db.VarChar(150)
  targetType  String   @map("target_type") @db.VarChar(100)
  targetId    String?  @map("target_id") @db.VarChar(128)
  result      String   @default("SUCCESS") @db.VarChar(50)
  requestId   String?  @map("request_id") @db.VarChar(128)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(512)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actorUser   User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  userId      String               @map("user_id") @db.Uuid
  severity    NotificationSeverity @default(INFO)
  title       String               @db.VarChar(255)
  message     String               @db.Text
  relatedType String?              @map("related_type") @db.VarChar(100)
  relatedId   String?              @map("related_id") @db.VarChar(128)
  isRead      Boolean              @default(false) @map("is_read")
  readAt      DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}
