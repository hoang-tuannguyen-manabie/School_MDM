# =============================================================================
# SCHOOL MDM PORTAL - ENVIRONMENT CONFIGURATION EXAMPLE
# Copy this file to .env and replace placeholder values before running.
# NEVER commit real secrets or .env files to version control.
# =============================================================================

# --- Application Environment ---
NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
PUBLIC_LAN_URL=https://mdm.school.local

# --- Supabase / PostgreSQL (School DB) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_CHANGE_ME
DATABASE_URL=postgresql://postgres.your-project-ref:CHANGE_ME_URL_ENCODED_PASSWORD@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DIRECT_DATABASE_URL=postgresql://postgres:CHANGE_ME_URL_ENCODED_PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# --- Redis (Queue, Cache, Idempotency & Socket Coordination) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Authentication & Security ---
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS_ACCESS_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS_REFRESH_SECRET_KEY
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# --- MDM Provider Configuration ---
# Supported providers: HEADWIND_COMMUNITY | CLASSROOM_DPC
MDM_DEFAULT_PROVIDER=CLASSROOM_DPC

# Headwind MDM Community Configuration (Optional when using CLASSROOM_DPC)
HEADWIND_BASE_URL=http://localhost:18080
HEADWIND_API_KEY=CHANGE_ME_HEADWIND_API_KEY
HEADWIND_TIMEOUT_MS=10000

# Direct Classroom DPC / Local LAN Agent Configuration (Zero-cost classroom mode)
CLASSROOM_DPC_SHARED_SECRET=CHANGE_ME_MIN_32_CHARS_DEVICE_ENROLLMENT_SECRET
CLASSROOM_HEARTBEAT_INTERVAL_SEC=15
CLASSROOM_OFFLINE_THRESHOLD_SEC=45
