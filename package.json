{
  "name": "school-mdm",
  "version": "0.1.0",
  "private": true,
  "description": "School MDM Portal - Classroom Android Tablet Management System",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "dev": "turbo run dev --concurrency=4",
    "lint": "turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
